---
import { withBase } from '../utils/url'

interface Props {
  reason: string
  heading?: string
  subline?: string
  ctaLabel?: string
}

const {
  reason,
  heading = 'Lassen Sie uns Ihr Projekt persönlich besprechen.',
  subline = 'Vereinbaren Sie einen unverbindlichen Termin – telefonisch, per Video oder vor Ort. Wir hören zu, denken mit und entwickeln gemeinsam mit Ihnen die passende Lösung.',
  ctaLabel = 'Gesprächstermin vereinbaren'
} = Astro.props

const ctaHref = withBase(`/kontakt?reason=${reason}&meeting=1`)
---

<section class="relative isolate overflow-hidden py-20 sm:py-24">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-slate-900 via-sky-900 to-slate-950"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_15%_20%,rgba(56,189,248,0.35),transparent_55%),radial-gradient(circle_at_85%_75%,rgba(251,191,36,0.18),transparent_50%)]"
  >
  </div>

  <div class="mx-auto w-full max-w-7xl px-6 sm:px-8 lg:px-12">
    <div
      class="flex flex-col gap-8 rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm sm:p-12 lg:flex-row lg:items-center lg:justify-between lg:p-14"
    >
      <div class="max-w-2xl space-y-4">
        <p
          class="inline-flex items-center rounded-full border border-sky-300/30 bg-sky-500/15 px-4 py-1 text-xs font-semibold uppercase tracking-[0.26em] text-sky-200"
        >
          Nächster Schritt
        </p>
        <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl">
          {heading}
        </h2>
        <p class="text-base leading-relaxed text-slate-200">
          {subline}
        </p>
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
        <a
          href={ctaHref}
          class="inline-flex items-center justify-center rounded-full bg-sky-400 px-7 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-slate-950 shadow-[0_18px_42px_rgba(56,189,248,0.55)] transition hover:-translate-y-0.5 hover:bg-sky-300 hover:shadow-[0_22px_50px_rgba(56,189,248,0.7)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-200 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
        >
          {ctaLabel}
        </a>
        <a
          href="tel:+491742457273"
          class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/5 px-7 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-white transition hover:border-white/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
        >
          Direkt anrufen
        </a>
      </div>
    </div>
  </div>
</section>
