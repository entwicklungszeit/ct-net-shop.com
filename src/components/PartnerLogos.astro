---
interface Logo {
  src: string
  alt: string
  label: string
  /** White inset behind the logo in dark mode (logo stays on dark card). */
  darkPad?: boolean
  /** Entire card stays white in dark mode, like light mode (for black wordmarks). */
  lightTile?: boolean
}

interface Props {
  eyebrow?: string
  heading: string
  intro?: string
  logos: Logo[]
}

const { eyebrow = 'Partner', heading, intro, logos } = Astro.props
---

<section class="py-20 sm:py-24">
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-8 lg:px-12">
    <div class="mb-10 max-w-3xl space-y-3">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-600 dark:text-sky-300">
        {eyebrow}
      </p>
      <h2
        class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-slate-50"
      >
        {heading}
      </h2>
      {
        intro && (
          <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">{intro}</p>
        )
      }
    </div>

    <ul
      class="flex flex-wrap items-center gap-3 sm:gap-4"
      aria-label="Partner und Hersteller"
    >
      {
        logos.map(logo => (
          <li
            class:list={[
              'group flex h-20 min-w-[160px] flex-1 items-center justify-center rounded-2xl border px-5 py-4 shadow-sm transition',
              'border-slate-200 bg-white hover:border-sky-300 hover:shadow-[0_12px_30px_rgba(14,165,233,0.15)]',
              logo.lightTile
                ? 'dark:border-slate-200 dark:bg-white dark:hover:border-sky-300 dark:hover:shadow-[0_12px_30px_rgba(14,165,233,0.15)]'
                : 'dark:border-slate-800 dark:bg-slate-900/70 dark:hover:border-sky-500/60'
            ]}
            data-partner-logo
          >
            <span
              class:list={[
                'inline-flex max-w-full items-center justify-center',
                logo.darkPad &&
                  !logo.lightTile &&
                  'dark:rounded-xl dark:bg-white dark:px-5 dark:py-4 sm:dark:px-6 sm:dark:py-4'
              ]}
            >
              <img
                src={logo.src}
                alt={logo.alt}
                loading="lazy"
                decoding="async"
                class:list={[
                  'max-h-12 w-auto max-w-[140px] opacity-80 transition group-hover:opacity-100',
                  logo.lightTile ? 'dark:opacity-80' : 'dark:opacity-95'
                ]}
                data-partner-img
                data-label={logo.label}
              />
            </span>
            <span
              class="hidden text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-300"
              data-partner-fallback
            >
              {logo.label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Show a clean text fallback only when the image file fails to load.
  function applyPartnerFallback(img: HTMLImageElement) {
    const li = img.closest('[data-partner-logo]')
    if (!li) return
    const fallback = li.querySelector<HTMLElement>('[data-partner-fallback]')
    if (!fallback) return
    img.classList.add('hidden')
    fallback.classList.remove('hidden')
  }

  document.querySelectorAll<HTMLImageElement>('[data-partner-img]').forEach(img => {
    img.addEventListener('error', () => applyPartnerFallback(img))
  })
</script>
