---
interface Logo {
  src: string
  alt: string
  label: string
  href?: string
}

interface Props {
  eyebrow?: string
  heading: string
  intro?: string
  logos: Logo[]
  trailingNote?: string
  /** 'warm' calls out a single named partner (e.g. a trade partner) instead of a neutral trust-logo row. */
  tone?: 'sky' | 'warm'
}

const { eyebrow = 'Partner', heading, intro, logos, trailingNote, tone = 'sky' } = Astro.props
const isWarm = tone === 'warm'

const wrapperClass = isWarm
  ? 'relative overflow-hidden rounded-3xl border border-orange-200/70 bg-gradient-to-br from-orange-50 via-white to-white p-8 pl-9 sm:p-10 sm:pl-11 dark:border-orange-400/20 dark:from-orange-500/10 dark:via-slate-900 dark:to-slate-900'
  : ''

const eyebrowClass = isWarm
  ? 'inline-flex items-center gap-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-orange-700 dark:border-orange-400/30 dark:bg-orange-400/10 dark:text-orange-300'
  : 'text-xs font-semibold uppercase tracking-[0.24em] text-sky-600 dark:text-sky-300'

const tileClass = isWarm
  ? 'group flex h-20 min-w-[160px] flex-1 items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-4 shadow-sm transition hover:border-orange-300 hover:shadow-[0_12px_30px_rgba(249,115,22,0.18)] dark:border-slate-700 dark:bg-slate-900'
  : 'group flex h-20 min-w-[160px] flex-1 items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-4 shadow-sm transition hover:border-sky-300 hover:shadow-[0_12px_30px_rgba(14,165,233,0.15)]'
---

<section class="py-20 sm:py-24">
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-8 lg:px-12">
    <div class={wrapperClass}>
      {
        isWarm && (
          <span
            aria-hidden="true"
            class="absolute inset-y-0 left-0 w-1.5 bg-gradient-to-b from-orange-500 to-orange-700 dark:from-orange-400 dark:to-orange-300"
          />
        )
      }
      <div class="mb-10 max-w-3xl space-y-3">
        <p class={eyebrowClass}>
          {
            isWarm && (
              <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-orange-500 dark:bg-orange-400" />
            )
          }
          {eyebrow}
        </p>
        <h2
          class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-slate-50"
        >
          {heading}
        </h2>
        {
          intro && (
            <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">{intro}</p>
          )
        }
      </div>

      <ul
        class="flex flex-wrap items-center gap-3 sm:gap-4"
        aria-label="Partner und Hersteller"
      >
      {
        logos.map(logo => {
          const Tag = logo.href ? 'a' : 'div'
          const linkProps = logo.href
            ? {
                href: logo.href,
                target: '_blank',
                rel: 'noopener noreferrer',
                'aria-label': `Zur Website von ${logo.label} (öffnet in neuem Tab)`
              }
            : {}
          return (
            <li class={tileClass} data-partner-logo>
              <Tag
                {...linkProps}
                class="flex items-center justify-center"
              >
                <img
                  src={logo.src}
                  alt={logo.alt}
                  loading="lazy"
                  decoding="async"
                  class="max-h-12 w-auto max-w-[140px] opacity-80 transition group-hover:opacity-100"
                  data-partner-img
                  data-label={logo.label}
                />
                <span
                  class="hidden text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"
                  data-partner-fallback
                >
                  {logo.label}
                </span>
              </Tag>
            </li>
          )
        })
      }
      {
        trailingNote && (
          <li class="flex h-20 min-w-[160px] flex-1 items-center justify-center px-5 py-4 text-sm font-medium italic text-slate-500 dark:text-slate-400">
            {trailingNote}
          </li>
        )
      }
      </ul>
    </div>
  </div>
</section>

<script>
  // Show a clean text fallback only when the image file fails to load.
  function applyPartnerFallback(img: HTMLImageElement) {
    const li = img.closest('[data-partner-logo]')
    if (!li) return
    const fallback = li.querySelector<HTMLElement>('[data-partner-fallback]')
    if (!fallback) return
    img.classList.add('hidden')
    fallback.classList.remove('hidden')
  }

  document.querySelectorAll<HTMLImageElement>('[data-partner-img]').forEach(img => {
    img.addEventListener('error', () => applyPartnerFallback(img))
  })
</script>
