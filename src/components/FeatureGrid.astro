---
import Icon from './Icon.astro'
import type { IconSlug } from '../data/icons'

interface Feature {
  title: string
  description: string
  icon?: IconSlug
}

interface Props {
  eyebrow?: string
  heading?: string
  intro?: string
  features: Feature[]
  columns?: 2 | 3 | 4
  variant?: 'default' | 'muted'
}

const {
  eyebrow,
  heading,
  intro,
  features,
  columns = 3,
  variant = 'default'
} = Astro.props

const gridClass =
  columns === 4
    ? 'grid gap-6 sm:grid-cols-2 lg:grid-cols-4'
    : columns === 2
      ? 'grid gap-6 md:grid-cols-2'
      : 'grid gap-6 md:grid-cols-2 lg:grid-cols-3'

const sectionClass =
  variant === 'muted'
    ? 'relative isolate overflow-hidden border-y border-slate-200 bg-white py-20 sm:py-24 dark:border-slate-800 dark:bg-slate-900/40'
    : 'py-20 sm:py-24'
---

<section class={sectionClass}>
  {
    variant === 'muted' && (
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_10%_20%,rgba(14,165,233,0.14),transparent_42%),radial-gradient(circle_at_94%_82%,rgba(251,191,36,0.12),transparent_40%)] dark:bg-[radial-gradient(circle_at_10%_20%,rgba(14,165,233,0.16),transparent_42%),radial-gradient(circle_at_94%_82%,rgba(129,140,248,0.16),transparent_40%)]"
      />
    )
  }
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-8 lg:px-12">
    {
      (eyebrow || heading || intro) && (
        <div class="mb-12 max-w-3xl space-y-3">
          {eyebrow && (
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-600 dark:text-sky-300">
              {eyebrow}
            </p>
          )}
          {heading && (
            <h2 class="text-balance text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-50">
              {heading}
            </h2>
          )}
          {intro && (
            <p class="text-base leading-relaxed text-slate-600 dark:text-slate-300">{intro}</p>
          )}
        </div>
      )
    }

    <div class={gridClass}>
      {
        features.map((feature, index) => (
          <article class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_12px_30px_rgba(15,23,42,0.06)] transition hover:-translate-y-1 hover:border-sky-300 hover:shadow-[0_18px_38px_rgba(14,165,233,0.18)] dark:border-slate-800 dark:bg-slate-900/85 dark:shadow-[0_12px_30px_rgba(2,6,23,0.5)] dark:hover:border-sky-500/70">
            <div class="mb-4 flex items-center gap-3">
              <span
                class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-sky-500/10 text-sky-600 ring-1 ring-inset ring-sky-500/20 dark:bg-sky-400/10 dark:text-sky-300 dark:ring-sky-400/30"
              >
                {
                  feature.icon ? (
                    <Icon name={feature.icon} class="h-5 w-5" />
                  ) : (
                    <span class="text-lg" aria-hidden="true">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                  )
                }
              </span>
              <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-50">
                {feature.title}
              </h3>
            </div>
            <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              {feature.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
