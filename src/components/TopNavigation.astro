---
import Icon from './Icon.astro'
import { services } from '../data/services'
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-md dark:border-slate-800 dark:bg-slate-950/95"
>
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label="CT-Net Startseite">
      <img src="/logo.svg" alt="CT-Net" class="h-8" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-8 lg:flex" aria-label="Hauptmenü">
      <button
        type="button"
        data-megamenu-toggle
        aria-expanded="false"
        aria-controls="megamenu-panel"
        class="group flex items-center gap-1.5 text-sm font-medium text-slate-700 transition-colors hover:text-sky-600 dark:text-slate-300 dark:hover:text-sky-400"
      >
        Dienstleistungen
        <svg
          class="h-4 w-4 transition-transform duration-200 group-data-open:rotate-180"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
          ></path>
        </svg>
      </button>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <!-- Theme toggle (desktop) -->
      <button
        type="button"
        data-theme-toggle
        class="flex h-10 w-10 items-center justify-center rounded-lg text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-slate-100"
        aria-label="Hellmodus aktivieren"
      >
        <span class="dark:hidden" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </span>
        <span class="hidden dark:inline" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
        </span>
      </button>
      <!-- Desktop CTA -->
      <a
        href="/kontakt?meeting=1"
        class="shrink-0 rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 dark:bg-sky-500 dark:text-slate-950 dark:hover:bg-sky-400"
      >
        Termin vereinbaren
      </a>
    </div>

    <!-- Mobile: hamburger -->
    <button
      type="button"
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 dark:text-slate-300 dark:hover:bg-slate-800 lg:hidden"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="drawer-nav"
      data-drawer-toggle
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Mega-menu panel (desktop) -->
<div
  id="megamenu-panel"
  data-megamenu
  aria-hidden="true"
  class="pointer-events-none fixed top-14 left-0 right-0 z-40 hidden border-b border-slate-200/80 bg-white/95 opacity-0 backdrop-blur-md transition-[opacity,transform] duration-200 ease-out -translate-y-1 dark:border-slate-800 dark:bg-slate-950/95 lg:block data-visible:pointer-events-auto data-visible:translate-y-0 data-visible:opacity-100"
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <p
      class="mb-5 text-[10px] font-semibold uppercase tracking-[0.28em] text-sky-600 dark:text-sky-400"
    >
      Dienstleistungen
    </p>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        services.map(service => (
          <a
            href={service.href}
            data-megamenu-close
            class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_8px_24px_rgba(15,23,42,0.07)] transition hover:-translate-y-0.5 hover:border-sky-300 hover:shadow-[0_12px_32px_rgba(14,165,233,0.18)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 dark:border-slate-800 dark:bg-slate-900/85 dark:hover:border-sky-500/70"
          >
            <div
              class="absolute right-4 top-4 inline-flex h-9 w-9 items-center justify-center rounded-xl bg-sky-500/10 text-sky-600 ring-1 ring-inset ring-sky-500/20 dark:bg-sky-400/10 dark:text-sky-300 dark:ring-sky-400/30"
            >
              <Icon name={service.icon} class="h-4 w-4" />
            </div>
            <h3 class="text-xl font-semibold text-slate-900 transition group-hover:text-sky-600 dark:text-slate-50 dark:group-hover:text-sky-300">
              {service.title}
            </h3>
            <p class="mt-2 max-w-[38ch] text-sm leading-relaxed text-slate-500 dark:text-slate-400">
              {service.description}
            </p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-400">
              Mehr erfahren
              <span aria-hidden="true" class="transition group-hover:translate-x-1">
                -&gt;
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</div>

<!-- Mobile drawer -->
<div
  id="drawer-nav"
  class="pointer-events-none fixed inset-0 z-40 lg:hidden data-drawer-open:pointer-events-auto"
  aria-hidden="true"
  data-drawer
>
  <div
    class="absolute inset-0 bg-slate-900/40 opacity-0 transition-opacity duration-300 data-visible:opacity-100"
    data-drawer-overlay
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute right-0 top-0 flex h-full w-full max-w-xs flex-col gap-6 border-l border-slate-200 bg-white p-6 shadow-xl transition-transform duration-300 ease-out translate-x-full data-visible:translate-x-0 dark:border-slate-800 dark:bg-slate-900 sm:max-w-sm"
    data-drawer-panel
  >
    <div class="flex items-center justify-between">
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-slate-600 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
        aria-label="Menü schließen"
        data-drawer-close
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="flex flex-1 flex-col gap-1" aria-label="Mobile Menü">
      <!-- Dienstleistungen accordion -->
      <div>
        <button
          type="button"
          data-drawer-services-toggle
          aria-expanded="false"
          aria-controls="drawer-services-panel"
          class="flex w-full items-center justify-between rounded-lg px-4 py-3 text-base font-medium text-slate-700 transition hover:bg-slate-50 hover:text-sky-600 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          Dienstleistungen
          <svg
            class="h-4 w-4 shrink-0 transition-transform duration-200 data-open:rotate-180"
            data-drawer-services-chevron
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
            ></path>
          </svg>
        </button>
        <div
          id="drawer-services-panel"
          data-drawer-services-panel
          class="overflow-hidden transition-[max-height] duration-200 ease-in-out max-h-0 data-visible:max-h-96"
        >
          <div class="mt-1 flex flex-col gap-0.5 pl-4">
            {
              services.map(service => (
                <a
                  href={service.href}
                  data-drawer-close
                  class="rounded-lg px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-sky-600 dark:text-slate-300 dark:hover:bg-slate-800"
                >
                  {service.title}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </nav>
    <!-- Theme toggle (mobile) -->
    <button
      type="button"
      data-theme-toggle
      class="flex items-center justify-center gap-2 rounded-lg px-4 py-3 text-base font-medium text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800"
      aria-label="Hellmodus aktivieren"
      data-drawer-close
    >
      <span class="dark:hidden" aria-hidden="true">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </span>
      <span class="hidden dark:inline" aria-hidden="true">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
      </span>
      <span class="dark:hidden">Dunkelmodus</span>
      <span class="hidden dark:inline">Hellmodus</span>
    </button>
    <a
      href="/kontakt?meeting=1"
      class="rounded-lg bg-sky-500 px-4 py-3 text-center text-sm font-semibold text-white transition hover:bg-sky-400 dark:bg-sky-400 dark:text-slate-950"
      data-drawer-close
    >
      Termin vereinbaren
    </a>
  </div>
</div>

<script>
  function initTheme() {
    const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')

    function getIsDark() {
      return document.documentElement.classList.contains('dark')
    }

    function setTheme(dark: boolean) {
      document.documentElement.classList.toggle('dark', dark)
      localStorage.theme = dark ? 'dark' : 'light'
      updateAriaLabels()
    }

    function updateAriaLabels() {
      const label = getIsDark() ? 'Hellmodus aktivieren' : 'Dunkelmodus aktivieren'
      toggles.forEach(btn => btn.setAttribute('aria-label', label))
    }

    toggles.forEach(btn => {
      btn.addEventListener('click', () => {
        setTheme(!getIsDark())
      })
    })

    updateAriaLabels()

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
      if (!('theme' in localStorage)) {
        document.documentElement.classList.toggle('dark', e.matches)
        updateAriaLabels()
      }
    })
  }

  function initDrawer() {
    const drawer = document.querySelector<HTMLElement>('[data-drawer]')
    const overlay = document.querySelector<HTMLElement>('[data-drawer-overlay]')
    const panel = document.querySelector<HTMLElement>('[data-drawer-panel]')
    const toggle = document.querySelector<HTMLElement>('[data-drawer-toggle]')
    const closeButtons = document.querySelectorAll<HTMLElement>('[data-drawer-close]')

    if (!drawer || !overlay || !panel || !toggle) return

    function open() {
      drawer?.setAttribute('aria-hidden', 'false')
      drawer?.setAttribute('data-drawer-open', '')
      overlay?.setAttribute('data-visible', '')
      panel?.setAttribute('data-visible', '')
      toggle?.setAttribute('aria-expanded', 'true')
      document.body.style.overflow = 'hidden'
    }

    function close() {
      drawer?.setAttribute('aria-hidden', 'true')
      drawer?.removeAttribute('data-drawer-open')
      overlay?.removeAttribute('data-visible')
      panel?.removeAttribute('data-visible')
      toggle?.setAttribute('aria-expanded', 'false')
      document.body.style.overflow = ''
    }

    function toggleDrawer() {
      const isOpen = overlay?.hasAttribute('data-visible')
      if (isOpen) close()
      else open()
    }

    toggle.addEventListener('click', toggleDrawer)
    overlay?.addEventListener('click', close)
    closeButtons.forEach(el => el.addEventListener('click', close))
  }

  function initMegaMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-megamenu-toggle]')
    const panel = document.querySelector<HTMLElement>('[data-megamenu]')
    const closeLinks = document.querySelectorAll<HTMLElement>('[data-megamenu-close]')

    if (!toggle || !panel) return

    function open() {
      panel!.setAttribute('data-visible', '')
      panel!.setAttribute('aria-hidden', 'false')
      toggle!.setAttribute('aria-expanded', 'true')
      toggle!.setAttribute('data-open', '')
    }

    function close() {
      panel!.removeAttribute('data-visible')
      panel!.setAttribute('aria-hidden', 'true')
      toggle!.setAttribute('aria-expanded', 'false')
      toggle!.removeAttribute('data-open')
    }

    function isOpen() {
      return panel!.hasAttribute('data-visible')
    }

    toggle.addEventListener('click', () => {
      if (isOpen()) close()
      else open()
    })

    closeLinks.forEach(link => link.addEventListener('click', close))

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && isOpen()) close()
    })

    document.addEventListener('click', e => {
      if (!isOpen()) return
      const target = e.target as Node
      if (!toggle!.contains(target) && !panel!.contains(target)) {
        close()
      }
    })
  }

  function initDrawerServices() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-drawer-services-toggle]')
    const subPanel = document.querySelector<HTMLElement>('[data-drawer-services-panel]')
    const chevron = document.querySelector<HTMLElement>('[data-drawer-services-chevron]')

    if (!toggle || !subPanel) return

    toggle.addEventListener('click', () => {
      const isOpen = subPanel.hasAttribute('data-visible')
      if (isOpen) {
        subPanel.removeAttribute('data-visible')
        toggle.setAttribute('aria-expanded', 'false')
        chevron?.removeAttribute('data-open')
      } else {
        subPanel.setAttribute('data-visible', '')
        toggle.setAttribute('aria-expanded', 'true')
        chevron?.setAttribute('data-open', '')
      }
    })
  }

  initTheme()
  initDrawer()
  initMegaMenu()
  initDrawerServices()
</script>
