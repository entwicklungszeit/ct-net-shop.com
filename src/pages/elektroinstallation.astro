---
import Layout from '../layouts/Layout.astro'
import ServiceHero from '../components/ServiceHero.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import PartnerLogos from '../components/PartnerLogos.astro'
import CtaBanner from '../components/CtaBanner.astro'

const installationFeatures = [
  {
    icon: 'haus',
    title: 'Komplette Hausinstallation',
    description:
      'Von der Rohbauinstallation bis zur Feinmontage. Wir planen Ihre Anlage so, dass sie heute passt und für zukünftige Erweiterungen wie Smart Home oder PV bereit ist.'
  },
  {
    icon: 'gluehbirne',
    title: 'Individuelle Beleuchtungskonzepte',
    description:
      'Licht ist Atmosphäre. Wir planen und installieren funktionale Arbeitsbeleuchtung, stimmungsvolles Ambiente-Licht und sichere Außenbeleuchtung.'
  },
  {
    icon: 'sanierung',
    title: 'Modernisierung & Sanierung',
    description:
      'Wir bringen veraltete elektrische Anlagen in Bestandsbauten auf den aktuellen Stand der Technik und Sicherheit – inklusive Erneuerung des Zählerschranks.'
  },
  {
    icon: 'schliessanlage',
    title: 'Sprechanlagen & Sicherheit',
    description:
      'Moderne Türkommunikation mit Video-Funktion und Zutrittskontrolle für Ihr Plus an Sicherheit – sauber integriert in Ihre Hausinstallation.'
  },
  {
    icon: 'blitz',
    title: 'Schutz & Prävention',
    description:
      'Installation von Rauchwarnmeldern sowie effektiver Blitz- und Überspannungsschutz für Ihr gesamtes Gebäude. Sicherheit, an die Sie nicht denken müssen.'
  },
  {
    icon: 'wifi',
    title: 'SAT-Anlagen & Kopfstation',
    description:
      'Wir planen und installieren Satellitenanlagen und Kopfstationen für den zentralen TV-Empfang – vom Einfamilienhaus bis zur Wohnanlage, sauber verkabelt und normgerecht verteilt.'
  },
  {
    icon: 'wifi',
    title: 'DVB-S / DVB-T / DVB-C / DVB-IP Empfang',
    description:
      'Ob Satellit, Antenne, Kabel oder IPTV: Wir richten den passenden Fernsehempfang für Ihr Zuhause ein und sorgen für eine zuverlässige Signalverteilung im gesamten Gebäude.'
  },
  {
    icon: 'steckdose',
    title: 'Anschlussarbeiten Hausgeräte',
    description:
      'Vom Herd bis zur Waschmaschine: Wir übernehmen die fachgerechte elektrische Anbindung Ihrer Hausgeräte – sicher angeschlossen und geprüft.'
  }
]
---

<Layout>
  <main class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <ServiceHero
      eyebrow="Elektroinstallation"
      title="Das sichere Fundament Ihres Gebäudes."
      lead="Hinter jeder smarten Funktion und jeder Solaranlage steht eine solide, fachgerechte Elektroinstallation. Wir verbinden traditionelles Handwerk mit modernster Technik – ob Sie ein neues Haus bauen, eine Wohnung sanieren oder punktuelle Optimierungen wünschen."
      reason="elektroinstallation"
    />

    <section class="py-16 sm:py-20">
      <div class="mx-auto w-full max-w-7xl px-6 sm:px-8 lg:px-12">
        <div
          class="rounded-3xl border border-slate-200 bg-white p-8 sm:p-10 dark:border-slate-800 dark:bg-slate-900/85"
        >
          <p
            class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-600 dark:text-sky-300"
          >
            Unser Anspruch
          </p>
          <p
            class="mt-3 text-2xl font-semibold leading-snug tracking-tight text-slate-900 sm:text-3xl dark:text-slate-50"
          >
            Qualität, auf die Sie sich verlassen können – von der ersten Steckdose bis zum
            fertigen Schaltschrank.
          </p>
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-600 dark:text-slate-300">
            Wir sorgen dafür, dass der Strom sicher und effizient fließt. Saubere Verarbeitung,
            durchdachte Planung und nachvollziehbare Dokumentation sind für uns selbstverständlich
            – nicht erst auf Nachfrage.
          </p>
        </div>
      </div>
    </section>

    <FeatureGrid
      eyebrow="Leistungen im Überblick"
      heading="Wir begleiten Sie bei allen elektrischen Herausforderungen."
      intro="Von einzelnen Optimierungen bis zur kompletten Hausinstallation – Sie haben einen Ansprechpartner, der die Verantwortung trägt."
      features={installationFeatures}
      columns={3}
      variant="muted"
    />

    <PartnerLogos
      eyebrow="Verlässliche Partner"
      heading="Hochwertige Komponenten – aus gutem Grund."
      intro="Wir verbauen ausschließlich Materialien namhafter Hersteller. Das spüren Sie an Sicherheit, Lebensdauer und Wertbeständigkeit Ihrer Anlage."
      logos={[
        { src: '/partners/hager.svg', alt: 'Hager', label: 'Hager' },
        { src: '/partners/wuerth.svg', alt: 'Würth', label: 'Würth' },
        { src: '/partners/kathrein.svg', alt: 'Kathrein', label: 'Kathrein' },
        { src: '/partners/siedle.svg', alt: 'Siedle', label: 'Siedle' },
        { src: '/partners/ritto.svg', alt: 'Ritto', label: 'Ritto' },
        { src: '/partners/osram.svg', alt: 'Osram', label: 'Osram' },
        { src: '/partners/philips.svg', alt: 'Philips', label: 'Philips' },
        { src: '/partners/esylux.svg', alt: 'Esylux', label: 'Esylux' },
        { src: '/partners/kaiser.svg', alt: 'Kaiser', label: 'Kaiser' },
        { src: '/partners/berker.svg', alt: 'Berker', label: 'Berker' },
        { src: '/partners/busch-jaeger.svg', alt: 'Busch-Jaeger', label: 'Busch-Jaeger' },
        { src: '/partners/jung.svg', alt: 'Jung', label: 'Jung' },
        { src: '/partners/metz.svg', alt: 'Metz', label: 'Metz' }
      ]}
    />

    <CtaBanner
      reason="elektroinstallation"
      heading="Sicher, zukunftsfähig und sauber dokumentiert."
      subline="Vereinbaren Sie ein unverbindliches Gespräch. Wir besprechen Ihr Vorhaben, prüfen die Anforderungen vor Ort und entwickeln eine Lösung, die heute passt – und morgen bereit ist."
    />
  </main>
</Layout>
