---
import Layout from '../layouts/Layout.astro'
import { withBase } from '../utils/url'
---

<Layout>
  <main class="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <section class="mx-auto w-full max-w-6xl px-6 py-20 sm:px-8 lg:px-12">
      <div class="max-w-3xl space-y-5">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-600 dark:text-sky-300">
          Dienstleistungen
        </p>
        <h1
          class="text-4xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 sm:text-5xl"
        >
          Photovoltaik
        </h1>
        <p class="text-base leading-relaxed text-slate-700 dark:text-slate-300">
          Wir entwickeln Photovoltaik-Konzepte, die technisch und wirtschaftlich zu Ihrem Objekt
          passen. Planung, Material, Montage und Inbetriebnahme greifen bei uns sauber ineinander.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <article
          class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/85"
        >
          <h2 class="text-lg font-semibold">Konzept</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            Analyse der Flächen, Auslegung der Komponenten und transparente Ertrags- sowie
            Wirtschaftlichkeitsbetrachtung.
          </p>
        </article>
        <article
          class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/85"
        >
          <h2 class="text-lg font-semibold">Montage</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            Zuverlässige Installation mit Fokus auf Sicherheit, langlebige Komponenten und
            termingerechte Ausführung.
          </p>
        </article>
        <article
          class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/85"
        >
          <h2 class="text-lg font-semibold">Inbetriebnahme</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            Anschluss, Funktionstest und Übergabe inklusive klarer Einweisung für den
            alltagstauglichen Betrieb.
          </p>
        </article>
      </div>

      <div class="mt-12">
        <a
          href={withBase('/kontakt')}
          class="inline-flex items-center justify-center rounded-full bg-sky-500 px-7 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-slate-950 transition hover:bg-sky-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2"
        >
          Photovoltaik Projekt anfragen
        </a>
      </div>
    </section>
  </main>
</Layout>
