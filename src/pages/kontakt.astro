---
import Layout from '../layouts/Layout.astro'
const thankYouUrl = new URL('/kontakt/danke/', Astro.site).href
---

<Layout>
  <main class="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <section class="relative isolate px-6 py-20 sm:px-8 lg:px-12">
      <div
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,rgba(56,189,248,0.14),transparent_60%),radial-gradient(circle_at_bottom,rgba(251,191,36,0.12),transparent_55%)] dark:bg-[radial-gradient(circle_at_top,rgba(56,189,248,0.18),transparent_60%),radial-gradient(circle_at_bottom,rgba(129,140,248,0.18),transparent_55%)]"
      >
      </div>
      <div class="mx-auto max-w-5xl lg:grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-16">
        <!-- Intro & address -->
        <div class="space-y-10">
          <header class="space-y-4">
            <p
              class="inline-flex items-center rounded-full border border-sky-100 bg-sky-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-sky-700 dark:border-slate-700 dark:bg-slate-900/60 dark:text-sky-300"
            >
              Kontakt
            </p>
            <h1
              class="text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-50"
            >
              Smart. Stabil. Leistungsstark.
            </h1>
            <p
              class="max-w-xl text-sm leading-relaxed text-slate-600 sm:text-base dark:text-slate-300"
            >
              Erzählen Sie uns von Ihrem Projekt – Photovoltaik, Netzwerktechnik oder
              Hausautomation. Wir melden uns zeitnah mit einer individuellen Antwort.
            </p>
          </header>

          <div
            class="grid gap-6 rounded-2xl border border-slate-200 bg-white/90 p-6 shadow-[0_18px_50px_rgba(15,23,42,0.08)] backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900/70 dark:shadow-[0_18px_60px_rgba(15,23,42,0.9)] sm:grid-cols-2 sm:p-8"
          >
            <div class="space-y-4">
              <h2
                class="text-sm font-semibold tracking-[0.18em] text-slate-500 dark:text-slate-400"
              >
                Anschrift
              </h2>
              <div class="text-sm leading-relaxed text-slate-900 dark:text-slate-100">
                <p class="font-medium">Rico Pleißner</p>
                <p>F 5</p>
                <p>04523 Elstertrebnitz</p>
              </div>
            </div>

            <dl class="space-y-5 text-sm text-slate-700 dark:text-slate-200">
              <div class="space-y-1">
                <dt
                  class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400"
                >
                  Festnetz
                </dt>
                <dd>
                  <a
                    href="tel:+4934296924981"
                    class="inline-flex items-center gap-2 text-sky-600 transition hover:text-sky-500 dark:text-sky-300 dark:hover:text-sky-200"
                  >
                    <span>+49&nbsp;34296&nbsp;/&nbsp;92&nbsp;49&nbsp;81</span>
                  </a>
                </dd>
              </div>

              <div class="space-y-1">
                <dt
                  class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400"
                >
                  Mobil
                </dt>
                <dd>
                  <a
                    href="tel:+491742457273"
                    class="inline-flex items-center gap-2 text-sky-600 transition hover:text-sky-500 dark:text-sky-300 dark:hover:text-sky-200"
                  >
                    <span>+49&nbsp;174&nbsp;24&nbsp;57&nbsp;273</span>
                  </a>
                </dd>
              </div>

              <div class="space-y-1">
                <dt
                  class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400"
                >
                  WhatsApp
                </dt>
                <dd>
                  <a
                    href="https://wa.me/4915140071268"
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center gap-2 text-sky-600 transition hover:text-sky-500 dark:text-sky-300 dark:hover:text-sky-200"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      class="h-4 w-4 shrink-0 fill-current"
                    >
                      <path
                        d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.32 4.95L2 22l5.2-1.36a9.96 9.96 0 0 0 4.84 1.24h.01c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm0 18.2a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.09.81.82-3.01-.19-.31a8.2 8.2 0 1 1 6.94 3.84Zm4.5-6.14c-.25-.12-1.47-.72-1.7-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.78.96-.14.16-.29.18-.53.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.23.25-.85.83-.85 2.02s.87 2.34 1 2.5c.12.16 1.7 2.6 4.13 3.65.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.14-1.18-.06-.1-.23-.16-.48-.28Z"
                      ></path>
                    </svg>
                    <span>+49&nbsp;1514&nbsp;0071268</span>
                  </a>
                </dd>
              </div>

              <div class="space-y-1">
                <dt
                  class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400"
                >
                  Fax
                </dt>
                <dd class="text-slate-800 dark:text-slate-100">
                  +49&nbsp;34296&nbsp;/&nbsp;92&nbsp;49&nbsp;82
                </dd>
              </div>

              <div class="space-y-1">
                <dt
                  class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400"
                >
                  E-Mail
                </dt>
                <dd>
                  <a
                    href="mailto:info@ct-net-shop.com"
                    class="inline-flex items-center gap-2 text-sky-600 underline-offset-4 transition hover:text-sky-500 hover:underline dark:text-sky-300 dark:hover:text-sky-200 dark:hover:underline"
                  >
                    info@ct-net-shop.com
                  </a>
                </dd>
              </div>
            </dl>
          </div>
        </div>

        <!-- Contact form -->
        <div class="mt-12 lg:mt-0">
          <form
            action="https://formspree.io/f/xqejznwy"
            method="POST"
            class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_18px_50px_rgba(15,23,42,0.08)] backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900/80 dark:shadow-[0_18px_50px_rgba(15,23,42,0.9)] sm:p-8"
          >
            <input type="hidden" name="_next" value={thankYouUrl} />
            <h2 class="text-lg font-medium tracking-tight text-slate-900 dark:text-slate-50">
              Schreiben Sie uns eine Nachricht
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Felder mit
              <span class="text-rose-400">*</span>
              sind Pflichtfelder.
            </p>

            <!-- Company -->
            <div class="space-y-2">
              <label
                for="company"
                class="block text-xs font-medium tracking-wide text-slate-800 dark:text-slate-200"
              >
                Firma
              </label>
              <input
                id="company"
                name="company"
                type="text"
                autocomplete="organization"
                class="block w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 shadow-inner outline-none ring-0 transition focus:border-sky-500 focus:ring-2 focus:ring-sky-200 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:focus:border-sky-400 dark:focus:ring-sky-500/60"
              />
            </div>

            <!-- Name -->
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="space-y-2">
                <label
                  for="firstname"
                  class="flex items-center gap-1 text-xs font-medium tracking-wide text-slate-800 dark:text-slate-200"
                >
                  Vorname
                  <span class="text-rose-400">*</span>
                </label>
                <input
                  id="firstname"
                  name="firstname"
                  type="text"
                  autocomplete="given-name"
                  required
                  class="block w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 shadow-inner outline-none ring-0 transition focus:border-sky-500 focus:ring-2 focus:ring-sky-200 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:focus:border-sky-400 dark:focus:ring-sky-500/60"
                />
              </div>

              <div class="space-y-2">
                <label
                  for="lastname"
                  class="flex items-center gap-1 text-xs font-medium tracking-wide text-slate-800 dark:text-slate-200"
                >
                  Nachname
                  <span class="text-rose-400">*</span>
                </label>
                <input
                  id="lastname"
                  name="lastname"
                  type="text"
                  autocomplete="family-name"
                  required
                  class="block w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 shadow-inner outline-none ring-0 transition focus:border-sky-500 focus:ring-2 focus:ring-sky-200 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:focus:border-sky-400 dark:focus:ring-sky-500/60"
                />
              </div>
            </div>

            <!-- Address -->
            <fieldset
              class="space-y-4 rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800/70 dark:bg-slate-950/30"
            >
              <legend
                class="px-1 text-xs font-medium uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400"
              >
                Adresse
                <span class="text-rose-400">*</span>
              </legend>
              <div class="space-y-3">
                <div class="space-y-2">
                  <label
                    for="street"
                    class="block text-xs font-medium tracking-wide text-slate-800 dark:text-slate-200"
                  >
                    Straße
                  </label>
                  <input
                    id="street"
                    name="street"
                    type="text"
                    required
                    class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-inner outline-none ring-0 transition focus:border-sky-500 focus:ring-2 focus:ring-sky-200 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:focus:border-sky-400 dark:focus:ring-sky-500/60"
                  />
                </div>

                <div class="grid gap-3 grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
                  <div class="space-y-2">
                    <label
                      for="streetNumber"
                      class="block text-xs font-medium tracking-wide text-slate-800 dark:text-slate-200"
                    >
                      Nr.
                    </label>
                    <input
                      id="streetNumber"
                      name="streetNumber"
                      type="text"
                      required
                      class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-inner outline-none ring-0 transition focus:border-sky-500 focus:ring-2 focus:ring-sky-200 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:focus:border-sky-400 dark:focus:ring-sky-500/60"
                    />
                  </div>

                  <div class="space-y-2">
                    <label
                      for="zip"
                      class="block text-xs font-medium tracking-wide text-slate-800 dark:text-slate-200"
                    >
                      PLZ
                    </label>
                    <input
                      id="zip"
                      name="zip"
                      type="text"
                      inputmode="numeric"
                      required
                      class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-inner outline-none ring-0 transition focus:border-sky-500 focus:ring-2 focus:ring-sky-200 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:focus:border-sky-400 dark:focus:ring-sky-500/60"
                    />
                  </div>
                </div>

                <div class="space-y-2">
                  <label
                    for="city"
                    class="block text-xs font-medium tracking-wide text-slate-800 dark:text-slate-200"
                  >
                    Ort
                  </label>
                  <input
                    id="city"
                    name="city"
                    type="text"
                    required
                    class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-inner outline-none ring-0 transition focus:border-sky-500 focus:ring-2 focus:ring-sky-200 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:focus:border-sky-400 dark:focus:ring-sky-500/60"
                  />
                </div>
              </div>
            </fieldset>

            <!-- Contact information -->
            <fieldset
              class="space-y-4 rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800/70 dark:bg-slate-950/30"
            >
              <legend
                class="px-1 text-xs font-medium uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400"
              >
                Kontaktinformationen
                <span class="text-rose-400">*</span>
              </legend>
              <div class="space-y-3">
                <div class="space-y-2">
                  <label
                    for="phone"
                    class="block text-xs font-medium tracking-wide text-slate-800 dark:text-slate-200"
                  >
                    Telefon
                  </label>
                  <input
                    id="phone"
                    name="phone"
                    type="tel"
                    autocomplete="tel"
                    required
                    class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-inner outline-none ring-0 transition focus:border-sky-500 focus:ring-2 focus:ring-sky-200 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:focus:border-sky-400 dark:focus:ring-sky-500/60"
                  />
                </div>

                <div class="space-y-2">
                  <label
                    for="email"
                    class="block text-xs font-medium tracking-wide text-slate-800 dark:text-slate-200"
                  >
                    E-Mail
                  </label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                    class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-inner outline-none ring-0 transition focus:border-sky-500 focus:ring-2 focus:ring-sky-200 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:focus:border-sky-400 dark:focus:ring-sky-500/60"
                  />
                </div>
              </div>
            </fieldset>

            <!-- Contact questions -->
            <fieldset class="space-y-3">
              <legend
                class="text-xs font-medium uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400"
              >
                Kontaktwunsch
              </legend>

              <div class="space-y-2 text-xs text-slate-800 dark:text-slate-100">
                <label
                  class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2 transition hover:border-sky-400 hover:bg-sky-50 dark:border-slate-800/80 dark:bg-slate-950/40 dark:hover:border-sky-500/70 dark:hover:bg-slate-900/60"
                >
                  <input
                    type="checkbox"
                    name="contactQuestions"
                    value="callback"
                    class="mt-1 h-4 w-4 rounded border-slate-300 bg-white text-sky-500 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-900"
                  />
                  <span class="leading-relaxed"> Bitte rufen Sie mich telefonisch zurück. </span>
                </label>

                <label
                  class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2 transition hover:border-sky-400 hover:bg-sky-50 dark:border-slate-800/80 dark:bg-slate-950/40 dark:hover:border-sky-500/70 dark:hover:bg-slate-900/60"
                >
                  <input
                    type="checkbox"
                    name="contactQuestions"
                    value="meeting"
                    class="mt-1 h-4 w-4 rounded border-slate-300 bg-white text-sky-500 focus:ring-sky-500 dark:border-slate-600 dark:bg-slate-900"
                  />
                  <span class="leading-relaxed">
                    Ich möchte einen persönlichen Vor-Ort-Termin vereinbaren.
                  </span>
                </label>
              </div>
            </fieldset>

            <!-- Contact reason -->
            <div class="space-y-2">
              <label
                for="reason"
                class="flex items-center gap-1 text-xs font-medium tracking-wide text-slate-800 dark:text-slate-200"
              >
                Kontaktgrund
                <span class="text-rose-400">*</span>
              </label>
              <select
                id="reason"
                name="reason"
                required
                class="block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none ring-0 transition focus:border-sky-500 focus:ring-2 focus:ring-sky-200 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:focus:border-sky-400 dark:focus:ring-sky-500/60"
              >
                <option value="">Bitte wählen…</option>
                <option value="automation">Anfrage Hausautomation / KNX</option>
                <option value="photovoltaik">Anfrage Photovoltaik</option>
                <option value="waermepumpe">Anfrage Wärmepumpen-Anschluss</option>
                <option value="it-services">Anfrage IT-Infrastruktur</option>
                <option value="elektroinstallation">Anfrage Elektroinstallation</option>
                <option value="drohnenflug">Anfrage Drohnenflug / SKYEYE</option>
                <option value="support">Technische Unterstützung / Support</option>
                <option value="other">Sonstiges Anliegen</option>
              </select>
            </div>

            <!-- Message -->
            <div class="space-y-2">
              <label
                for="message"
                class="flex items-center gap-1 text-xs font-medium tracking-wide text-slate-800 dark:text-slate-200"
              >
                Nachricht
                <span class="text-rose-400">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="block w-full resize-none rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-inner outline-none ring-0 transition focus:border-sky-500 focus:ring-2 focus:ring-sky-200 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:focus:border-sky-400 dark:focus:ring-sky-500/60"
                placeholder="Beschreiben Sie Ihr Projekt, Ihre Fragen oder Ihr Anliegen so konkret wie möglich."
              ></textarea>
            </div>

            <!-- Submit -->
            <div
              class="flex flex-col gap-3 border-t border-slate-200 pt-4 dark:border-slate-800/80 sm:flex-row sm:items-center sm:justify-between"
            >
              <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-500">
                Mit dem Absenden Ihrer Nachricht erklären Sie sich damit einverstanden, dass wir
                Ihre Angaben zur Beantwortung Ihrer Anfrage verwenden.
              </p>
              <button
                type="submit"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-sky-500 px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.24em] text-slate-50 shadow-[0_12px_30px_rgba(56,189,248,0.45)] transition hover:bg-sky-400 hover:shadow-[0_14px_34px_rgba(56,189,248,0.6)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:text-slate-950 dark:shadow-[0_12px_35px_rgba(56,189,248,0.55)] dark:hover:shadow-[0_16px_40px_rgba(56,189,248,0.75)] dark:focus-visible:ring-offset-slate-950"
              >
                Nachricht senden
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <script
    src="https://www.google.com/recaptcha/api.js?render=6LdkkEgtAAAAAD6u69CxE_yAtoHMAlqH0poM-ro4"
    async
    defer></script>
  <script>
    declare const grecaptcha: any
    const form = document.querySelector('form')
    if (form) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        const token: string = await new Promise((resolve) => {
          grecaptcha.ready(() => {
            grecaptcha
              .execute('6LdkkEgtAAAAAD6u69CxE_yAtoHMAlqH0poM-ro4', { action: 'contact' })
              .then(resolve)
          })
        })
        const data = new FormData(form)
        data.append('g-recaptcha-response', token)
        const nextUrl = (form.querySelector('input[name="_next"]') as HTMLInputElement)?.value
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        })
        if (response.ok && nextUrl) {
          window.location.href = nextUrl
        }
      })
    }

    // Pre-fill the contact form based on URL query params (?reason=...&meeting=1).
    const params = new URLSearchParams(window.location.search)
    const reason = params.get('reason')
    if (reason) {
      const select = document.getElementById('reason')
      if (select instanceof HTMLSelectElement) {
        const exists = Array.from(select.options).some(o => o.value === reason)
        if (exists) select.value = reason
      }
    }
    if (params.get('meeting') === '1') {
      const cb = document.querySelector<HTMLInputElement>(
        'input[name="contactQuestions"][value="meeting"]'
      )
      if (cb) cb.checked = true
    }
  </script>
</Layout>
