---
import Layout from '../layouts/Layout.astro'
import { withBase } from '../utils/url'

const services = [
  {
    title: 'KNX Smart Home',
    href: '/knx',
    description:
      'Intelligente Hausautomation, die für Sie mitdenkt – Licht, Beschattung, Heizung und Sicherheit nahtlos vereint.'
  },
  {
    title: 'Photovoltaik',
    href: '/photovoltaik',
    description:
      'Werden Sie Ihr eigener Energieversorger. PV, Speicher, Wallbox und App-Steuerung aus einer Hand.'
  },
  {
    title: 'Wärmepumpe',
    href: '/waermepumpe',
    description:
      'Elektrischer Anschluss, Anmeldung beim Energieversorger und PV-Kopplung – sauber abgestimmt mit Ihrem Heizungsbauer.'
  },
  {
    title: 'IT-Infrastruktur',
    href: '/it',
    description:
      'Schluss mit Funklöchern und instabilem WLAN. Wir liefern Netzwerke, Sicherheit und Backups, die einfach funktionieren.'
  },
  {
    title: 'Elektroinstallation',
    href: '/elektroinstallation',
    description:
      'Das sichere Fundament jedes Gebäudes – vom Neubau bis zur Sanierung, inklusive Beleuchtung und Schutztechnik.'
  },
  {
    title: 'CTN-SKYEYE Drohnenflug',
    href: '/drohnenflug',
    description:
      'Picture2Fly, Video2Fly, Measurement2Fly und Hot2Fly – professionelle Luftaufnahmen. Ab 350 € mit Picture2Fly.'
  }
]

const processSteps = [
  {
    title: 'Unverbindliches Erstgespräch',
    description:
      'Wir nehmen uns Zeit für Ihr Anliegen, analysieren die Anforderungen und klären offene Fragen – direkt und ohne Umwege.'
  },
  {
    title: 'Individuelles Angebot',
    description:
      'Auf Basis Ihrer Anforderungen erstellen wir ein präzises, transparentes Angebot mit klarer Leistungsabgrenzung.'
  },
  {
    title: 'Angebotsprüfung',
    description: 'Sie prüfen das Angebot in Ruhe. Rückfragen beantworten wir kompetent und persönlich – jederzeit.'
  },
  {
    title: 'Schriftliche Auftragsbestätigung',
    description: 'Nach Ihrer Freigabe bestätigen wir den Auftrag verbindlich und nachvollziehbar dokumentiert.'
  },
  {
    title: 'Anzahlung',
    description:
      'Bei Projekten ab 2.000 € wird eine Anzahlung von 70 % fällig – kalkuliert auf Basis des Materialeinsatzes.'
  },
  {
    title: 'Materialbestellung & Beschaffung',
    description:
      'Alle benötigten Komponenten werden sorgfältig und qualitätsgeprüft bei unseren Fachlieferanten beschafft.'
  },
  {
    title: 'Vorlaufzeit ca. 4–6 Wochen',
    description:
      'Für eine planmäßige Durchführung kalkulieren wir eine Vorlaufzeit von ca. 4–6 Wochen ein. Wir halten Sie stets informiert.'
  }
]
---

<Layout>
  <main class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <section class="relative isolate overflow-hidden">
      <div class="absolute inset-0 -z-20">
        <img
          src={withBase('/Hintergrund.svg')}
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover object-center"
          loading="eager"
          decoding="async"
        />
      </div>
      <div
        class="absolute inset-0 -z-10 bg-[linear-gradient(108deg,rgba(2,6,23,0.84)_12%,rgba(2,6,23,0.56)_46%,rgba(2,6,23,0.86)_100%)]"
      >
      </div>
      <div class="mx-auto flex min-h-[78svh] w-full max-w-7xl items-center px-6 py-24 sm:px-8 lg:px-12">
        <div class="max-w-3xl space-y-8">
          <p
            class="inline-flex rounded-full border border-sky-300/40 bg-sky-500/20 px-4 py-1 text-xs font-semibold uppercase tracking-[0.26em] text-sky-100"
          >
            Smart, Stable, Powerful, Since 2009
          </p>
          <h1 class="text-4xl font-semibold leading-tight text-white sm:text-5xl lg:text-6xl">
            CT-Netware – Informations- & Elektrotechnik Pleißner.
          </h1>
          <p class="max-w-2xl text-base leading-relaxed text-slate-100 sm:text-lg">
            Ihr starker Partner in allen Fragen zu IT, Elektroinstallation und erneuerbarer
            Energie in Leipzig, Umgebung und sogar weit darüber hinaus. Bundesweit im Einsatz
            bieten wir Ihnen kompetente Planung und individuelle Lösungen für Ihre Projekte.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a
              href={withBase('/kontakt?meeting=1')}
              class="inline-flex items-center justify-center rounded-full bg-sky-500 px-7 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-slate-950 shadow-[0_16px_40px_rgba(14,165,233,0.45)] transition hover:bg-sky-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
            >
              Gesprächstermin vereinbaren
            </a>
            <span class="text-sm uppercase tracking-[0.14em] text-slate-200/95">
              Planung · Montage · Betreuung
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto w-full max-w-7xl px-6 py-20 sm:px-8 lg:px-12">
      <div class="mb-10 max-w-3xl space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-600 dark:text-sky-300">
          Dienstleistungen
        </p>
        <h2 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl">
          Eine Hand. Sechs starke Bereiche.
        </h2>
        <p class="text-base leading-relaxed text-slate-600 dark:text-slate-300">
          Von der intelligenten Gebäudesteuerung bis zur sauberen Elektroinstallation – alle
          Gewerke greifen bei uns sauber ineinander. Sie haben einen Ansprechpartner, der das
          Ganze versteht.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service, index) => (
            <a
              href={withBase(service.href)}
              class="group relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-8 shadow-[0_18px_38px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-sky-300 hover:shadow-[0_22px_45px_rgba(14,165,233,0.2)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 dark:border-slate-800 dark:bg-slate-900/85 dark:hover:border-sky-500/70"
            >
              <div class="absolute right-5 top-5 text-xs font-semibold tracking-[0.2em] text-slate-400">
                0{index + 1}
              </div>
              <h3 class="text-2xl font-semibold text-slate-900 transition group-hover:text-sky-600 dark:text-slate-50 dark:group-hover:text-sky-300">
                {service.title}
              </h3>
              <p class="mt-4 max-w-[36ch] text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {service.description}
              </p>
              <span class="mt-8 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">
                Mehr erfahren
                <span aria-hidden="true" class="transition group-hover:translate-x-1">
                  →
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="relative isolate overflow-hidden border-y border-slate-200 bg-white py-20 dark:border-slate-800 dark:bg-slate-900/40">
      <div
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_10%_20%,rgba(14,165,233,0.16),transparent_42%),radial-gradient(circle_at_94%_82%,rgba(251,191,36,0.14),transparent_40%)]"
      >
      </div>
      <div class="mx-auto w-full max-w-7xl px-6 sm:px-8 lg:px-12">
        <div class="mb-12 max-w-3xl space-y-4">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-600 dark:text-sky-300">
            Transparentes Vorgehen für Ihr Vorhaben
          </p>
          <h2 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl">
            Von der ersten Anfrage bis zur klaren Umsetzung
          </h2>
        </div>
        <ol class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {
            processSteps.map((step, index) => (
              <li class="rounded-2xl border border-slate-200 bg-slate-50/85 p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900/80">
                <div class="mb-3 flex items-center gap-3">
                  <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-sky-500 text-xs font-bold text-slate-950">
                    {index + 1}
                  </span>
                  <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
                    Schritt {index + 1}
                  </span>
                </div>
                <p class="text-sm font-semibold leading-snug text-slate-800 dark:text-slate-100">{step.title}</p>
                <p class="mt-1 text-sm leading-relaxed text-slate-500 dark:text-slate-400">{step.description}</p>
              </li>
            ))
          }
        </ol>
        <div class="mt-12">
          <a
            href={withBase('/kontakt?meeting=1')}
            class="inline-flex items-center justify-center rounded-full bg-slate-900 px-7 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 dark:bg-sky-400 dark:text-slate-950 dark:hover:bg-sky-300"
          >
            Jetzt Projekt gemeinsam besprechen
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
